APP_NAME="فروشگاه لوازم خانگی نودهی"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:3000

# Laravel + MongoDB / NoSQL Document Store Configuration
DB_CONNECTION=mongodb
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DATABASE="nodehi_store"
NOSQL_STORAGE_PATH="backend/database/mongodb"

# Frontend API URL
VITE_API_URL="/api"