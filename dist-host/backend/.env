APP_NAME="فروشگاه لوازم خانگی نودهی"
APP_ENV=production
APP_KEY=base64:Tm9kZWhpU3RvcmVTZWNyZXRLZXlGb3JDcGFuZWxTaGFyZWRIb3N0aW5nMjAyNg==
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=https://nodehi.ir

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# دیتابیس ساده SQLite (آماده استفاده روی هاست سی‌پنل پارس‌پک بدون نیاز به SSH یا ترمینال)
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=nodehi_

MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@nodehi.ir"
MAIL_FROM_NAME="${APP_NAME}"

SMS_DEFAULT_GATEWAY=mock
SMS_API_KEY=
SMS_SENDER=100000

ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

AUTH_OTP_DEV_MODE=true
