{
  "name": "nodehi-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "فروشگاه اینترنتی لوازم خانگی نودهی — React + TypeScript و Laravel (MongoDB / NoSQL)",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/seed-mongodb.mjs && tsc --noEmit && vite build && node scripts/build-cpanel-mongodb.mjs",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:seed": "node scripts/seed-mongodb.mjs --reset",
    "pack:cpanel": "node scripts/build-cpanel-mongodb.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
