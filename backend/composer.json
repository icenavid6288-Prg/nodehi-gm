{
    "name": "nodehi/backend",
    "type": "project",
    "description": "Nodehi E-Commerce Backend (Laravel 12 + MongoDB / NoSQL Document Store)",
    "keywords": ["laravel", "mongodb", "nosql", "ecommerce", "iran", "nodehi"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^12.0",
        "mongodb/laravel-mongodb": "^5.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
