APP_NAME="فروشگاه لوازم خانگی نودهی"
APP_ENV=production
APP_KEY=base64:Tm9kZWhpU3RvcmVTZWNyZXRLZXlGb3JDcGFuZWxTaGFyZWRIb3N0aW5nMjAyNg==
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_URL=https://nodehi.ir

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# دیتابیس پیش‌فرض: SQLite ساده و بدون نیاز به ساخت دیتابیس در cPanel یا اجرای ترمینال/SSH
# فایل دیتابیس در مسیر backend/database/database.sqlite از پیش ساخته و پر شده است.
DB_CONNECTION=sqlite
# در صورت تمایل به استفاده از MySQL در آینده، کافیست خطوط زیر را فعال کنید:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=nodehi_store
# DB_USERNAME=nodehi_user
# DB_PASSWORD=secret_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=nodehi_

MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@nodehi.ir"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend URL for CORS
FRONTEND_URL=https://nodehi.ir
SANCTUM_STATEFUL_DOMAINS=nodehi.ir

# SMS Gateway (Kavenegar / Ghasedak / FarazSMS)
SMS_DEFAULT_GATEWAY=mock
SMS_API_KEY=
SMS_SENDER=100000

# Payment Gateways (Zarinpal / SnappPay)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
SNAPPAY_CLIENT_ID=
SNAPPAY_CLIENT_SECRET=
SNAPPAY_USERNAME=
SNAPPAY_PASSWORD=

# فعال بودن کد آزمایشی ورود تا قبل از اتصال پنل پیامک
AUTH_OTP_DEV_MODE=true
